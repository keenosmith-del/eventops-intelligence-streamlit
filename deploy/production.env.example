# Copy to deploy/production.env (ignored), chmod 600, populate privately.
# Never use the original EventOps infrastructure or encryption key.
APP_SITE=https://eventops.example.invalid
RELEASE_TAG=replace-with-reviewed-release
RELEASE_REVISION=replace-with-source-commit
# postgresql+psycopg URL, sslmode=verify-full&sslrootcert=system
EVENTOPS_DATABASE_URL=
APP_PASSWORD=
N8N_WEBHOOK_TOKEN=
EVENTOPS_SERVICE_TOKEN=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
GEMINI_ENABLED=false
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_LIMIT=8
AGENT_DAILY_LIMIT=3
RUNS_PER_HOUR=30
RUNS_PER_WORKSPACE_HOUR=6
MAILTRAP_API_TOKEN=
MAILTRAP_ACCOUNT_ID=
MAILTRAP_INBOX_ID=
# n8n execution metadata, not companion histories/reviews; approve retention.
EXECUTIONS_DATA_MAX_AGE=168
