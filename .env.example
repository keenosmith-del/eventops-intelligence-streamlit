# Independent companion configuration. Never use the original DATABASE_URL.
EVENTOPS_DATABASE_URL=sqlite:///storage/eventops.db
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_LIMIT=20
FASTEMBED_CACHE_PATH=storage/models
CALENDAR_FEED_URL=https://www.officeholidays.com/ics/south-africa
WEB_SOURCE_URL=https://date.nager.at/api/v3/PublicHolidays/2026/ZA
MAILTRAP_API_TOKEN=
MAILTRAP_ACCOUNT_ID=
MAILTRAP_INBOX_ID=
# Set independent random secrets via scripts/configure_local.py
EVENTOPS_SERVICE_TOKEN=
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_URL=http://127.0.0.1:5679/webhook/eventops-verify
N8N_AGENT_URL=http://127.0.0.1:5679/webhook/eventops-agent
# Optional shared demonstration password. Required when PUBLIC_DEMO=true.
APP_PASSWORD=
PUBLIC_DEMO=false

# Iteration 002 local assessment source (explicit opt-in, backend controlled)
ENABLE_LOCAL_SCENARIO=false
ASSESSMENT_SOURCE_BASE_URL=
# Set only for a separately approved hosted controlled source.
ASSESSMENT_SOURCE_HOST=
# Optional read-only n8n execution metadata API for reconciliation.
N8N_METADATA_URL=
N8N_API_KEY=
STALE_RUN_SECONDS=180
# Protected workspace supplemental knowledge administration; disabled publicly.
KNOWLEDGE_ADMIN_ENABLED=false
KNOWLEDGE_ADMIN_PASSWORD=
# Full Compose only: generate an independent strong password.
COMPANION_POSTGRES_PASSWORD=
