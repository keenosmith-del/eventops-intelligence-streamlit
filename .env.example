# Independent companion configuration. Never use the original DATABASE_URL.
EVENTOPS_DATABASE_URL=sqlite:///storage/eventops.db
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_LIMIT=20
FASTEMBED_CACHE_PATH=storage/models
CALENDAR_FEED_URL=https://www.officeholidays.com/ics/south-africa
WEB_SOURCE_URL=https://date.nager.at/api/v3/PublicHolidays/2026/ZA
MAILTRAP_API_TOKEN=
MAILTRAP_ACCOUNT_ID=
MAILTRAP_INBOX_ID=
# Set independent random secrets via scripts/configure_local.py
EVENTOPS_SERVICE_TOKEN=
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_URL=http://127.0.0.1:5679/webhook/eventops-verify
N8N_AGENT_URL=http://127.0.0.1:5679/webhook/eventops-agent
# Optional shared demonstration password. Required when PUBLIC_DEMO=true.
APP_PASSWORD=
PUBLIC_DEMO=false
